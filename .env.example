# Where uploaded PDFs, your notes, and the app's cache are stored.
# Relative paths resolve against the directory you run the app from.
STUDY_WORKSPACE=workspace

# Only the AI features need these; the reader and notes work without them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Vision-capable model for AI page notes (they always include the page image).
OPENAI_VISION_MODEL=gpt-5-mini
# Point at any OpenAI-compatible endpoint (a local model, a proxy, …).
OPENAI_BASE_URL=

# A key saved in ~/.study-hack/config.json (the settings page) WINS over
# OPENAI_API_KEY above — the settings form has to take effect the moment it is
# saved. Clear the saved key to fall back to this file.

# Where the beta token proxy lives. Only for dogfooding against a local proxy;
# a compiled-in default is used otherwise.
STUDY_PROXY_URL=

# Overrides ~/.study-hack as the settings directory. Mainly for tests.
STUDY_CONFIG_DIR=
